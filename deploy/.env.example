# Copy to .env (chmod 600) and fill in. Generate secrets with:
#   openssl rand -hex 24
# Use hex strings for the passwords/keys below: the Postgres password goes
# into a URL and must not contain characters that need escaping.

# --- public endpoint -----------------------------------------------------
# DNS A/AAAA record of this name must point at the host before the first
# start, with ports 80 and 443 reachable (Let's Encrypt).
ANT_DOMAIN=ant.example.com
ACME_EMAIL=ops@example.com

# --- images ----------------------------------------------------------------
# Pin a release; upgrading = change this and `docker compose up -d`
# (read docs/operations.md "Upgrading" first).
ANT_IMAGE=ghcr.io/mapika/antimony:0.2.0
#SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.97

# --- secrets ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-hex
S3_ACCESS_KEY=change-me-hex
S3_SECRET_KEY=change-me-hex
#S3_BUCKET=antimony

# --- logging -----------------------------------------------------------------
#ANT_LOG=info

# =============================================================================
# Used by backup.sh, git-mirror.sh and the agents' hosts, not by compose.
# =============================================================================

# Backups: a directory on a SECOND disk/volume (or mount of remote storage)
# and how long to keep dated copies.
BACKUP_DIR=/mnt/backup/antimony
BACKUP_RETENTION_DAYS=14
# Optional: also copy the backup directory to an rclone remote
# (configure with `rclone config`, e.g. a Hetzner/Scaleway/B2 bucket).
#BACKUP_RCLONE_REMOTE=offsite:antimony-backup

# git-mirror.sh: where to read from and push to.
#   MIRROR_SOURCE_URL  antimony's git export; the token needs read access to
#                      everything (admin, or a principal with read on prefix "")
#   MIRROR_PUSH_URL    the remote that should always hold plain git
#   MIRROR_FORMAT      sha256 (identical ids; remote must support SHA-256
#                      repositories) or sha1 (converted history for GitHub)
MIRROR_DIR=/var/lib/antimony-mirror
MIRROR_SOURCE_URL=https://mirror:TOKEN@ant.example.com/repo.git
#MIRROR_PUSH_URL=git@github.com:your-org/monorepo.git
MIRROR_FORMAT=sha1
